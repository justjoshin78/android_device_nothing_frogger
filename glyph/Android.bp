android_app {
    name: "FroggerGlyph",
    defaults: ["SettingsLibDefaults"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
    ],
    required: ["privapp_whitelist_org.lineageos.glyph"],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.glyph",
    src: "privapp-permissions-glyph.xml",
    sub_dir: "permissions",
    filename: "privapp-permissions-org.lineageos.glyph.xml",
    system_ext_specific: true,
}
