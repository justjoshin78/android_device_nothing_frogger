<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default for Settings.Global.DEVICE_NAME $1=MANUFACTURER $2=MODEL-->
    <string name="def_device_name">Nothing Phone (4a)</string>

    <!-- Default for Settings.Global.DEVICE_NAME $1=MODEL-->
    <string name="def_device_name_simple">Phone (4a)</string>

    <!-- Set the automatic brightness mode on by default -->
    <bool name="def_screen_brightness_automatic_mode">true</bool>

    <!-- Keep the panel out of its 30 Hz AOD timing while the screen is on.
         The panel driver re-applies brightness when leaving 30 Hz, which
         shows up as a brief flash. -->
    <string name="def_min_refresh_rate" translatable="false">60.0</string>
</resources>
